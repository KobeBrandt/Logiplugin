APP_NAME=logimarketplaceproxy
APP_ENV=production
# Generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
APP_URL=https://logiplugin.com

# Logs go to `docker compose logs` instead of a file inside the container
LOG_CHANNEL=stderr
LOG_LEVEL=warning

LOGI_MARKETPLACE_BASE_URL=https://marketplace.logi.com
LOGI_MARKETPLACE_BUILD_ID=
LOGI_MARKETPLACE_CACHE_TTL=1800

# No database in production
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
